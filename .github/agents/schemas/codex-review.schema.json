{
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewed_sha", "round", "summary", "findings", "checks_performed", "unverified_claims", "recommendation", "recommendation_reason"],
  "properties": {
    "reviewed_sha": {"type": "string"},
    "round": {"type": "integer"},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "title", "detail", "evidence", "location", "assessment_of_response"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocking", "major", "minor", "note"]},
          "status": {"type": "string", "enum": ["open", "resolved", "withdrawn", "unresolved_disagreement"]},
          "title": {"type": "string"},
          "detail": {"type": "string"},
          "evidence": {"type": "string"},
          "location": {"type": "string"},
          "assessment_of_response": {"type": "string"}
        }
      }
    },
    "checks_performed": {"type": "array", "items": {"type": "string"}},
    "unverified_claims": {"type": "array", "items": {"type": "string"}},
    "recommendation": {"type": "string", "enum": ["approve", "defer", "reject"]},
    "recommendation_reason": {"type": "string"}
  }
}

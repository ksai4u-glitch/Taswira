  "scenes": [
    {
      "id": "1963",
      "title": "Four regions",
      "snapshot": "1963",
      "when": {"from": 1963, "to": 1967, "label": "1963 to 1967"},
      "camera": {"center": [9.1, 8.6], "zoom": 6},
      "text": "Before 1967, Nigeria's federation was made of large regions. A fourth, the Mid-Western Region, was carved out of the Western Region in 1963 (one source says 1964), and Lagos was a separate federal territory. The Northern Region alone covered about four-fifths of the country's land (79%, measured with today's state borders).",
      "sources": ["forumfed"],
      "disputed": "The Mid-Western Region is usually dated to 1963; the Forum of Federations chapter gives 1964."
    },
    {
      "id": "1967",
      "title": "Twelve states",
      "snapshot": "1967",
      "when": {"from": 1967, "to": 1976, "label": "27 May 1967"},
      "camera": {"center": [9.1, 8.6], "zoom": 6},
      "text": "On 27 May 1967, General Yakubu Gowon's military government replaced the four regions with 12 states by decree. The decree described each state as a list of existing provinces, and set up a commission to settle boundaries.",
      "sources": ["gazette-1967", "forumfed", "agent-check-25"]
    },
    {
      "id": "1976",
      "title": "Nineteen states and a new capital territory",
      "snapshot": "1976",
      "when": {"from": 1976, "to": 1987, "label": "3 February 1976"},
      "camera": {"center": [9.1, 8.6], "zoom": 6},
      "text": "In 1976 General Murtala Mohammed's government created seven more states, making 19, and designated a Federal Capital Territory for a new capital at Abuja. Lagos stayed the capital for now. Mid-Western was renamed Bendel.",
      "sources": ["gazette-1976", "forumfed", "wiki-statehood"]
    },
    {
      "id": "1987",
      "title": "Twenty-one states",
      "snapshot": "1987",
      "when": {"from": 1987, "to": 1991, "label": "23 September 1987"},
      "camera": {"center": [9.1, 8.6], "zoom": 6},
      "text": "On 23 September 1987, General Ibrahim Babangida's government created Katsina, from Kaduna, and Akwa Ibom, from Cross River.",
      "sources": ["dailytrust-1987", "wiki-akwaibom"]
    },
    {
      "id": "1991",
      "title": "Thirty states, and the capital moves",
      "snapshot": "1991",
      "when": {"from": 1991, "to": 1996, "label": "27 August 1991"},
      "camera": {"center": [9.1, 8.6], "zoom": 6},
      "text": "On 27 August 1991, nine more states were created: Abia, Delta, Edo, Jigawa, Kebbi, Kogi, Osun, Taraba and Yobe. Gongola was renamed Adamawa, and Bendel was split into Edo and Delta. Later the same year the federal capital officially moved from Lagos to Abuja.",
      "sources": ["thisday-1991", "forumfed", "wiki-kogi", "wiki-statehood", "agent-check-25"],
      "disputed": "Secondary sources give the 1991 decree as either No. 37 or No. 41, so no decree number is shown."
    },
    {
      "id": "1996",
      "title": "Thirty-six states",
      "snapshot": "1996",
      "when": {"from": 1996, "to": 2026, "label": "1 October 1996"},
      "camera": {"center": [9.1, 8.6], "zoom": 6},
      "text": "On 1 October 1996, General Sani Abacha announced six new states: Bayelsa, Ebonyi, Ekiti, Gombe, Nasarawa and Zamfara. This is the map of 36 states and the FCT that Nigeria still has today.",
      "sources": ["speech-1996"]
    }
  ]
}

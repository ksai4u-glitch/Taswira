    {
      "id": "meroe-kush",
      "kind": "point",
      "name": "Meroe · royal cemeteries",
      "coordinates": [
        16.937,
        33.757
      ],
      "what": "Meroe was a major centre of Kush. From the third century BCE, most Kushite rulers were buried here. Its royal cemeteries used steep-sided pyramids above tombs cut into the ground.",
      "evidence": "Archaeology and institutional/scholarly records",
      "location": "Representative point of the royal cemetery complex, separate from the royal city. It does not locate an individual pyramid footprint.",
      "status": "approx",
      "disputed": null,
      "sources": [
        "meroe-unesco",
        "meroe-nomination",
        "meroe-booklet"
      ],
      "uncertainty_km": 1,
      "monument": {
        "type": "pyramid",
        "from": -300,
        "to": -201,
        "note": "Original symbolic steep-sided royal funerary pyramid with chapel. Represents the documented third-century BCE burial phase, not a measured or individually dated tomb. The assembled cemetery is an architectural illustration: numbers, arrangement and reveal order are symbolic.",
        "sources": [
          "meroe-nomination"
        ],
        "setting": "royal-cemetery"
      },
      "short": "Meroe"
    },
    {

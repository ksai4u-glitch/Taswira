  "scenes": [
    {
      "id": "origins",
      "title": "Our species has an African story",
      "when": {
        "from": -298000,
        "to": -298000,
        "label": "About 300,000 years ago"
      },
      "camera": {
        "center": [
          19,
          10
        ],
        "zoom": 3.5
      },
      "show": [
        "jebel-irhoud"
      ],
      "dim": [],
      "text": "Rewind: the previous chapter ended around 5,000 years ago. Now we return to roughly 300,000 years ago. At Jebel Irhoud, early Homo sapiens remains were found with Middle Stone Age tools. This is one part of a much wider African story of human origins.",
      "sources": [
        "irhoud-mpg",
        "irhoud-dating",
        "irhoud-mindat"
      ],
      "disputed": null,
      "unchecked": null,
      "mood": "calm",
      "duration": 22,
      "clock": "ago",
      "scale": "Africa · human origins",
      "time_note": "REWIND · 5,000 → about 300,000 years ago. Approximate locality only."
    },
    {
      "id": "egypt",
      "title": "A state takes shape on the Nile",
      "when": {
        "from": -3100,
        "to": -3100,
        "label": "Around 3100 BCE"
      },
      "camera": {
        "center": [
          25,
          28
        ],
        "zoom": 4.5
      },
      "show": [
        "memphis-egypt"
      ],
      "dim": [],
      "text": "Jump forward by almost 300,000 years. Around 3100 BCE, the gradual unification of Upper and Lower Egypt reached a major stage. Memphis became a capital between the two regions.",
      "sources": [
        "egypt-ministry",
        "memphis-map"
      ],
      "disputed": null,
      "unchecked": null,
      "mood": "calm",
      "duration": 19,
      "scale": "North-east Africa · lower Nile",
      "time_note": "TIME SCALE CHANGES · years ago → BCE/CE. Gradual unification, not one exact event."
    },
    {
      "id": "meroe",
      "title": "Kush builds its own royal landscape",
      "when": {
        "from": -250,
        "to": -250,
        "label": "Third century BCE"
      },
      "camera": {
        "center": [
          17,
          31
        ],
        "zoom": 5.1
      },
      "show": [
        "meroe-kush"
      ],
      "dim": [],
      "text": "Further south on the Nile, Meroe was a major centre of Kush. In the third century BCE, royal burials here used steep-sided pyramids above underground tombs. The city and its royal cemeteries formed distinct parts of this landscape.",
      "sources": [
        "meroe-unesco",
        "meroe-nomination",
        "meroe-booklet"
      ],
      "disputed": null,
      "unchecked": null,
      "mood": "calm",
      "duration": 18,
      "scale": "Middle Nile · Kush",
      "focus_label": "Meroe · royal cemeteries"
    },
    {
      "id": "djenne",
      "title": "A town without an invented king",
      "when": {
        "from": -200,
        "to": -200,
        "label": "Around 200 BCE · within a longer urban sequence"
      },
      "camera": {
        "center": [
          13,
          -4.5
        ],
        "zoom": 5
      },
      "show": [
        "djenne-djenno"
      ],
      "dim": [],
      "text": "Shift west to the inland Niger delta. Djenné-Djenno grew from about 250 BCE. Archaeology reveals crafts, exchange and forms of self-government: an urban history alongside the stories of kings and courts.",
      "sources": [
        "unesco-djenne",
        "met-sahel",
        "unesco-djenne-components"
      ],
      "disputed": null,
      "unchecked": null,
      "mood": "calm",
      "duration": 16,
      "scale": "West Africa · inland Niger delta"
    },
    {
      "id": "aksum",
      "title": "Stone becomes architecture",
      "when": {
        "from": 350,
        "to": 350,
        "label": "Third–fourth centuries CE"
      },
      "camera": {
        "center": [
          13.5,
          36.5
        ],
        "zoom": 5.2
      },
      "show": [
        "aksum"
      ],
      "dim": [],
      "text": "In north-eastern Africa, Aksum’s great stone stelae were carved in the third and fourth centuries CE. Some turned a single block of stone into the image of a many-storeyed building.",
      "sources": [
        "aksum-unesco",
        "aksum-map"
      ],
      "disputed": null,
      "unchecked": null,
      "mood": "calm",
      "duration": 18,
      "scale": "North-east Africa · Aksum",
      "focus_label": "Aksum · stelae and tombs"
    },
    {
      "id": "ghana",
      "title": "Gold, exchange and an uncertain capital",
      "when": {
        "from": 1100,
        "to": 1100,
        "label": "Around 1100 CE · selected trade context"
      },
      "camera": {
        "center": [
          16,
          -7
        ],
        "zoom": 4.9
      },
      "show": [
        "ghana-wagadu"
      ],
      "dim": [],
      "text": "Ghana, also called Wagadu, was linked to medieval gold exchange. Koumbi Saleh was a commercial centre; whether it was the capital remains debated. This earlier Ghana lay far from the present-day country of the same name.",
      "sources": [
        "dueppen-west-africa",
        "met-sahel",
        "brill-loc-coordinates"
      ],
      "disputed": "The identification of Koumbi Saleh as Ghana’s political capital is debated. The scene locates the archaeological trading town, not a confirmed palace.",
      "unchecked": null,
      "mood": "calm",
      "duration": 18,
      "scale": "Western Sahel · Ghana / Wagadu"
    },
    {
      "id": "kanem",
      "title": "A centre east of Lake Chad",
      "when": {
        "from": 1250,
        "to": 1250,
        "label": "Thirteenth century CE · regional overview"
      },
      "camera": {
        "center": [
          15,
          17
        ],
        "zoom": 4.7
      },
      "show": [],
      "dim": [],
      "text": "Now east of Lake Chad. Kanem linked communities across the Sahara. Recent archaeological work considers Tié a probable location of Njimi, an early Islamic capital. The identification remains a research question as the regional story comes into focus.",
      "sources": [
        "frobenius-kanem",
        "magnavita-2025",
        "dai-tie-2020"
      ],
      "disputed": "Tié’s identification with Njimi is probable, not certain. No unverified capital point or medieval lake shoreline is drawn.",
      "unchecked": null,
      "mood": "calm",
      "duration": 20,
      "scale": "Central Sahel · east of Lake Chad"
    },
    {
      "id": "mali",
      "title": "Mali, Musa and a city of learning",
      "when": {
        "from": 1324,
        "to": 1324,
        "label": "1324 CE · Musa’s pilgrimage",
        "approx": false
      },
      "camera": {
        "center": [
          16,
          -4
        ],
        "zoom": 5
      },
      "show": [
        "mali-timbuktu"
      ],
      "dim": [],
      "text": "In 1324, Mali’s ruler Musa travelled to Mecca through Cairo. His patronage helped Timbuktu develop as a centre of Islamic study. Timbuktu enters this tour as a commercial and scholarly city.",
      "sources": [
        "met-sahel",
        "unesco-timbuktu"
      ],
      "disputed": null,
      "unchecked": null,
      "mood": "calm",
      "duration": 18,
      "scale": "Western Sahel · Mali and Timbuktu"
    },
    {
      "id": "zimbabwe",
      "title": "A city built in stone",
      "when": {
        "from": 1400,
        "to": 1400,
        "label": "Around 1400 CE · later building phase"
      },
      "camera": {
        "center": [
          -20,
          30
        ],
        "zoom": 5.1
      },
      "show": [
        "great-zimbabwe"
      ],
      "dim": [],
      "text": "Far to the south, Great Zimbabwe grew into a major trading city. Its fourteenth-century Great Enclosure shows the skill of its stone builders. The enclosure and conical tower form part of the site’s later architectural ensemble.",
      "sources": [
        "unesco-great-zimbabwe",
        "unesco-great-zimbabwe-map"
      ],
      "disputed": null,
      "unchecked": null,
      "mood": "calm",
      "duration": 18,
      "scale": "Southern Africa · Great Zimbabwe",
      "focus_label": "Great Zimbabwe · stone city"
    },
    {
      "id": "kilwa",
      "title": "Africa faces the Indian Ocean too",
      "when": {
        "from": 1400,
        "to": 1400,
        "label": "Thirteenth–fourteenth centuries CE"
      },
      "camera": {
        "center": [
          -8.8,
          37
        ],
        "zoom": 5
      },
      "show": [
        "kilwa"
      ],
      "dim": [],
      "text": "Turn toward the Indian Ocean. Kilwa Kisiwani flourished as a Swahili trading city in the thirteenth and fourteenth centuries. Its sea connections belong in Africa’s history alongside the Sahara and the Niger.",
      "sources": [
        "kilwa-unesco",
        "kilwa-map"
      ],
      "disputed": null,
      "unchecked": null,
      "mood": "calm",
      "duration": 17,
      "scale": "East Africa · Kilwa Kisiwani"
    },
    {
      "id": "songhai",
      "title": "Gao and the Songhai world",
      "when": {
        "from": 1495,
        "to": 1495,
        "label": "1495 CE · monument at Gao",
        "approx": false
